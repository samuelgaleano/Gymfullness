rules_version = '2';

// Gymfullness — Firestore security rules.
// Each signed-in user can only read/write their own documents:
//   users/{uid}/{routines|sessions|bodyLogs|customExercises}/{id}
//   users/{uid}/meta/{profile|settings|plan}
// Everything else is denied.
// Deploy: Firebase console → Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isRecordCollection(collection) {
      return collection in ['routines', 'sessions', 'bodyLogs', 'customExercises'];
    }

    function isMetaDoc(collection, docId) {
      return collection == 'meta' && docId in ['profile', 'settings', 'plan'];
    }

    // Basic shape/size guard. Firestore itself caps documents at 1 MiB.
    // `_syncedAt` must be the server time of the write (serverTimestamp()), which keeps the
    // app's incremental sync ("documents changed since…") reliable.
    function isValidWrite(collection, docId) {
      let data = request.resource.data;
      return data is map
        && data.size() <= 60
        && data._syncedAt == request.time
        && (!('updatedAt' in data) || data.updatedAt is number)
        && (!isRecordCollection(collection) || data.id == docId);
    }

    match /users/{uid}/{collection}/{docId} {
      allow get, delete: if isOwner(uid)
        && (isRecordCollection(collection) || isMetaDoc(collection, docId));
      // Collection queries (the app reads whole collections / "changed since" queries).
      allow list: if isOwner(uid)
        && (isRecordCollection(collection) || collection == 'meta');
      allow create, update: if isOwner(uid)
        && (isRecordCollection(collection) || isMetaDoc(collection, docId))
        && isValidWrite(collection, docId);
    }

    // Deny everything else (explicit; Firestore denies by default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
