# Gymfullness — environment variables
# Local dev: copy this file to .env.local and fill it in.
# Production: Cloudflare Pages → your project → Settings → Variables and secrets (then redeploy).
# Everything is optional: with no variables the app works 100% as a guest (data on the device).

# --- Google login + cloud sync (Firebase). PUBLIC values from the Firebase web-app config. ---
# All four are required to enable login. See docs/SETUP.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- AI coach (optional). SECRETS: server-only, never prefix them with VITE_. ---
# Without any key the in-app coach answers offline (rule-based). Pick ONE provider:
COACH_PROVIDER=          # anthropic | gemini | openai (empty = first key found)
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=       # Claude Haiku 5.5 by default
# Any OpenAI-compatible API (GLM, Groq, OpenRouter, DeepSeek…):
COACH_API_KEY=
COACH_BASE_URL=          # e.g. https://open.bigmodel.cn/api/paas/v4
COACH_MODEL=             # model id (optional for gemini/anthropic, required for openai)
COACH_DAILY_LIMIT=       # max AI questions/day per instance (empty = no cap)
COACH_ALLOWED_ORIGINS=   # extra allowed origins, comma-separated
# iOS Google sign-in helper (see docs/SETUP.md)
FIREBASE_PROJECT_ID=
