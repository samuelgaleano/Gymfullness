# Gymfullness — environment variables
# Local dev: copy this file to .env.local and fill it in.
# Production: Vercel → your project → Settings → Environment Variables (then redeploy).
# Everything is optional: with no variables the app works 100% as a guest (data on the device).

# --- Google login + cloud sync (Firebase). PUBLIC values from the Firebase web-app config. ---
# All four are required to enable login. See docs/SETUP.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- AI coach (optional). SECRET: server-only, never prefix it with VITE_. ---
# Without it the in-app coach answers offline (rule-based).
ANTHROPIC_API_KEY=
# Max AI questions per day per server instance (best effort). Empty = no daily cap.
COACH_DAILY_LIMIT=
# Model override (default: claude-haiku-5-5).
COACH_MODEL=
# Extra allowed origins for the coach API, comma-separated (e.g. https://midominio.com).
COACH_ALLOWED_ORIGINS=
